# --- Auth0 (shared across jytech apps) ---
# Generate AUTH0_SECRET via: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Database (Neon Postgres) ---
# Pooled connection for runtime (serverless functions)
DATABASE_URL=
# Unpooled connection for drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# --- Chatbot (xAI / Grok) ---
XAI_API_KEY=

# --- Blog generation (Claude on AWS Bedrock, jytech account) ---
# Uses a named AWS profile (assumes the jytech org-account role). For static
# keys instead, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY and drop AWS_PROFILE.
AWS_PROFILE=jytech-admin
AWS_REGION=us-east-1
# Cross-region inference profile ID (override per account/region/model).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Blog auto-generation cron ---
# Shared secret between /api/cron/generate-post and the Cloudflare worker
# (workers/blog-cron). Generate via: openssl rand -hex 32
CRON_SECRET=

# --- Contact form (Brevo) ---
REVO_API_KEY=

# --- Google Sheets (shared jytech service account) ---
# Full service-account JSON on one line (reuse autoclaw's GA_SERVICE_ACCOUNT_KEY).
# Share any sheet with autoclaw-analytics@jytech.iam.gserviceaccount.com (Viewer).
GOOGLE_SERVICE_ACCOUNT_KEY=
